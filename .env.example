# File append-only: si aggiunge una riga in fondo, non si riordina.
# Copia in backend/.env e adatta se serve. `.env` non si committa mai.

# Cartella dei dataset Open Data (relativa a backend/, o assoluta)
PRESIDIO_DATA_DIR=../data

# Database locale, si rigenera dai file in data/
PRESIDIO_DATABASE_URL=sqlite:///./presidio.db

# Carica i dataset allo startup se il database è vuoto
PRESIDIO_AUTO_SEED=true

# Modello locale (LM Studio, endpoint OpenAI-compatibile)
PRESIDIO_LLM_BASE_URL=http://127.0.0.1:1234/v1
PRESIDIO_LLM_MODEL=google/gemma-4-e4b

# Groq: secondo provider, usato se il modello locale non risponde.
# La chiave NON va committata: il repo e' pubblico.
PRESIDIO_GROQ_API_KEY=
PRESIDIO_GROQ_MODEL=openai/gpt-oss-120b
